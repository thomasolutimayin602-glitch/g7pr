    "sentences": [
      {
        "index": 0,
        "id": "h-001",
        "japanese": "本屋です。",
        "chinese": "这是书店。",
        "kata": "ホンヤ デス。",
        "analysis": "「本屋」在店铺语境读ほんや（非もとや）。",
        "has_source": true,
        "source_slice": "source_audio_slices/0e590cdafae9b863.mp3",
        "start": 0.0,
        "end": 0.92,
        "duration": 0.92,
        "single_audio": "test_p41_cosyvoice/female_narrator_h-001.mp3"
      },
      {
        "index": 1,
        "id": "h-002",
        "japanese": "駅へ 行きます。",
        "chinese": "去车站。",
        "kata": "エキ エ イキマス。",
        "analysis": "格助词「へ」读作「エ」(e)，绝不读成「he」；「行きます」读いきます。",
        "has_source": true,
        "source_slice": "source_audio_slices/89ff9e6a59d1e0df.mp3",
        "start": 1.27,
        "end": 2.43,
        "duration": 1.16,
        "single_audio": "test_p41_cosyvoice/female_narrator_h-002.mp3"
      },
      {
        "index": 2,
        "id": "h-003",
        "japanese": "李さんは 今 レストランへ 行きます。",
        "chinese": "小李现在去餐厅。",
        "kata": "リサン ワ イマ レストラン エ イキマス。",
        "analysis": "「李」音读リ；「今」时间副词读いま；助词「は」读ワ、「へ」读エ。",
        "has_source": false,
        "source_slice": "",
        "start": 2.78,
        "end": 5.06,
        "duration": 2.28,
        "single_audio": "test_p41_cosyvoice/female_narrator_h-003.mp3"
      },
      {
        "index": 3,
        "id": "h-004",
        "japanese": "高橋さんは あした 公園へ 行きます。",
        "chinese": "高桥明天去公园。",
        "kata": "タカハシサン ワ アシタ コーエン エ イキマス。",
        "analysis": "「高橋」读たかはし；「公園」长音读コーエン；助词「は」读ワ、「へ」读エ。",
        "has_source": false,
        "source_slice": "",
        "start": 5.41,
        "end": 8.33,
        "duration": 2.92,
        "single_audio": "test_p41_cosyvoice/female_narrator_h-004.mp3"
      },
      {
        "index": 4,
        "id": "h-005",
        "japanese": "中山さん、どこへ 行きますか。",
        "chinese": "中山，你去哪里？",
        "kata": "ナカヤマサン、 ドコ エ イキマスカ。",
        "analysis": "「中山」读なかやま；助词「へ」读エ；终助词「か」疑问升调。",
